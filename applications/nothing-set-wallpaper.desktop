[Desktop Entry]
Type=Application
Name=Set as wallpaper
Comment=Use this picture as the Nothing shell's wallpaper, on every screen
# Shows in a file manager's "Open with" for pictures, never in the launcher.
# The path reaches the shell as an argument ($1), never inside the script.
Exec=sh -c 'qs -p "$HOME/.config/quickshell/nothing" ipc call wallpaper set "$1"' set-wallpaper %f
TryExec=qs
Icon=preferences-desktop-wallpaper
Terminal=false
NoDisplay=true
MimeType=image/png;image/jpeg;image/webp;
Categories=Graphics;

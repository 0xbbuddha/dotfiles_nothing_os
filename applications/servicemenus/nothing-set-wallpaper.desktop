[Desktop Entry]
Type=Service
# A Dolphin context-menu action (~/.local/share/kio/servicemenus), not an
# application: an app declaring image types can end up as the default
# picture opener, and double-clicking a photo would change the wallpaper.
MimeType=image/png;image/jpeg;image/webp;
Actions=setWallpaper;setWallpaperHere;
X-KDE-Priority=TopLevel

[Desktop Action setWallpaper]
Name=Set as wallpaper
Icon=preferences-desktop-wallpaper
# The path reaches the shell as an argument ($1), never inside the script.
Exec=sh -c 'qs -p "$HOME/.config/quickshell/nothing" ipc call wallpaper set "$1"' set-wallpaper %f

[Desktop Action setWallpaperHere]
Name=Set as wallpaper on this screen
Icon=preferences-desktop-wallpaper
# The screen the pointer is on, as Hyprland sees it (wallpaper.setHere).
Exec=sh -c 'qs -p "$HOME/.config/quickshell/nothing" ipc call wallpaper setHere "$1"' set-wallpaper %f

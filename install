#!/usr/bin/env bash
# Nothing - installer.
#
#   ./install              packages, ~/.config copies, SDDM session
#   ./install --deps       packages only
#   ./install --files      ~/.config + theme, skip pacman
#   ./install --uninstall  restore ~/.config backups (not packages)
#   ./install --noconfirm  no prompts
#
# Does not run as root. sudo is asked only where it is needed.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
NOTHING_ROOT="$ROOT"
export NOTHING_ROOT
# shellcheck source=scripts/lib.sh
source "$ROOT/scripts/lib.sh"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

DO_DEPS=true
DO_FILES=true
DO_SESSION=true
UNINSTALL=false

usage() {
    cat <<'EOF'
Nothing - installer.

  ./install              packages, ~/.config copies, SDDM session
  ./install --deps       packages only
  ./install --files      ~/.config + theme, skip pacman
  ./install --uninstall  restore ~/.config backups (not packages)
  ./install --noconfirm  no prompts

Puts Hyprland, Quickshell, hypridle and hyprlock into ~/.config
as real copies (rsync/cp, no symlinks). What was already there is backed up.
Does not run as root. sudo is asked only where it is needed.
EOF
    exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage 0 ;;
        --deps) DO_FILES=false; DO_SESSION=false ;;
        --files) DO_DEPS=false ;;
        --replace|--replace-config) ;; # default: always write ~/.config
        --uninstall) UNINSTALL=true; DO_DEPS=false; DO_FILES=false; DO_SESSION=false ;;
        --noconfirm|-y) NOCONFIRM=true ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done

need_root_denied

# The step numbers are worked out up front rather than counted as we go:
# each stage runs in its own process, so a counter living in this shell
# would never reach them, and --files alone would still print "02".
N=0
STEP_DEPS=0; STEP_FILES=0; STEP_SESSION=0
[[ "$DO_DEPS" == true ]]    && { N=$((N + 1)); STEP_DEPS=$N; }
[[ "$DO_FILES" == true ]]   && { N=$((N + 1)); STEP_FILES=$N; }
[[ "$DO_SESSION" == true ]] && { N=$((N + 1)); STEP_SESSION=$N; }

plan_row() {
    printf '  %s%02d%s  %-10s %s%s%s\n' "$RED" "$1" "$RST" "$2" "$FAINT" "$3" "$RST"
}

install_files() {
    step "$STEP_FILES" "config"

    log "Shaders"
    run bash "$ROOT/scripts/compile-shaders.sh" \
        || warn "shader compile failed (settings dots fall back to Canvas)"

    log "App theme: Dolphin, GTK, icons, file pickers"
    run bash "$ROOT/scripts/apply-app-theme.sh"

    log "Copies into $HOME/.config: hypr, quickshell, scripts, theme"
    run bash "$ROOT/scripts/install-config.sh"
}

install_session() {
    step "$STEP_SESSION" "session"

    log "Registers a \"Nothing\" entry in the display manager."
    field "writes" "/usr/share/wayland-sessions/nothing.desktop"
    field ""       "/usr/local/bin/nothing-session"
    field ""       "the astronaut greeter theme"
    log "The plain Hyprland entry loads this rice too, once the copies are in."
    echo

    if ask_yn "Add the Nothing session and SDDM theme?" y; then
        run sudo bash "$ROOT/scripts/install-session.sh"
    else
        warn "Skipped. You can still start from a TTY:"
        field "" "$ROOT/scripts/nothing-session.sh"
    fi
}

if [[ "$UNINSTALL" == true ]]; then
    echo
    banner
    step 1 "uninstall"
    bash "$ROOT/scripts/uninstall.sh"
    if [[ -f /usr/share/wayland-sessions/nothing.desktop ]]; then
        if ask_yn "Remove the SDDM session too?" y; then
            run sudo bash "$ROOT/scripts/install-session.sh" --remove
        fi
    fi
    # Built by apply-icon-theme.sh, so it is ours to offer to clean up.
    # Nothing else writes there, and leaving it makes Dolphin keep an icon
    # theme the rest of the rice no longer installs.
    if [[ -d "$DATA_HOME/icons/Nothing" ]]; then
        if ask_yn "Remove the generated icon theme too?" y; then
            run rm -rf "$DATA_HOME/icons/Nothing"
        fi
    fi
    echo
    ok "Done."
    exit 0
fi

echo
banner
echo
printf '  %sHyprland and Quickshell, in the shape of Nothing OS.%s\n' "$DIM" "$RST"
printf '  %sUnofficial, not affiliated with Nothing Technology.%s\n\n' "$FAINT" "$RST"

field "repo"    "$ROOT"
field "target"  "$HOME/.config"
field "backups" "*.bak-$(date +%Y%m%d)-<time>"
echo

[[ "$DO_DEPS" == true ]]    && plan_row "$STEP_DEPS"    "packages" "Arch / EndeavourOS, plus AUR"
[[ "$DO_FILES" == true ]]   && plan_row "$STEP_FILES"   "config"   "hypr, quickshell, scripts, theme"
[[ "$DO_SESSION" == true ]] && plan_row "$STEP_SESSION" "session"  "a \"Nothing\" entry in SDDM"
echo

printf '  %sAnything already at those paths is backed up, never overwritten.%s\n\n' \
       "$DIM" "$RST"
pause

if [[ "$DO_DEPS" == true ]]; then
    NOTHING_STEP="$STEP_DEPS" bash "$ROOT/scripts/install-deps.sh"
fi
[[ "$DO_FILES" == true ]] && install_files
[[ "$DO_SESSION" == true ]] && install_session

echo
rule
printf '  %s%s%s\n' "$BLD" "$(track "READY")" "$RST"
rule
printf '  Log out and pick %sNothing%s in the session list,\n' "$BLD" "$RST"
printf '  or start it from a TTY:\n'
field "" "$ROOT/scripts/nothing-session.sh"
echo
printf '  %s%s%s\n' "$DIM" "$(track "KEYS")" "$RST"
field "SUPER"   "launcher and workspaces"
field "SUPER+I" "settings"
field "SUPER+V" "clipboard"
field "SUPER+G" "game bar"
echo
field "your binds" "$HOME/.config/hypr/custom.lua"
field "uninstall"  "./install --uninstall"
echo

      { "t": "stat", "value": "data ? fmt.round(data.GBP, 3) : '-'", "caption": "'GBP'", "size": "s" },
      { "t": "stat", "value": "data ? fmt.round(data.JPY, 1) : '-'", "caption": "'JPY'", "size": "s" }
    ] }
  ],
  "actions": {},
  "tick": []
}

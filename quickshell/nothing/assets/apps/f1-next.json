{
  "name": "F1 Next",
  "icon": "󰄋",
  "size": "m",
  "face": "stat",
  "title": "LIGHTS OUT",
  "prompt": "the next Formula 1 grand prix with a countdown to lights out",
  "sources": ["net"],
  "state": {},
  "slots": {
    "value": "data && data[0] ? fmt.until(data[0].date + 'T' + (data[0].time || '12:00:00Z')) : '—'",
